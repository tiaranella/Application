generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  name            String
  
  organizedEvents Event[]  @relation("EventOrganizer")
  participatingIn Event[]  @relation("EventParticipants")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  // Optional short description
  date        DateTime // Will store both Date & Time
  location    String   // Required text field
  capacity    Int?     // Optional: If null, it means unlimited capacity
  isPublic    Boolean  @default(true) // true = Public, false = Private
  
  organizerId Int
  organizer   User     @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  
  participants User[]  @relation("EventParticipants")
}
